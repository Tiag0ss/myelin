{
  "TableName": "ApplicationAgentRules",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true,
      "Comment": "Primary key - application agent rule"
    },
    {
      "FieldName": "ApplicationId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - Applications.Id this rule belongs to"
    },
    {
      "FieldName": "Name",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Comment": "Display name of the rule"
    },
    {
      "FieldName": "Slug",
      "DataType": "varchar(128)",
      "NotNullable": true,
      "Comment": "Stable slug identifier within the application"
    },
    {
      "FieldName": "Content",
      "DataType": "mediumtext",
      "NotNullable": false,
      "Comment": "Markdown rule content served via MCP"
    },
    {
      "FieldName": "SortOrder",
      "DataType": "int",
      "NotNullable": true,
      "DefaultValue": "0",
      "Comment": "Display and merge order (lower first)"
    },
    {
      "FieldName": "UpdatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
      "Comment": "Auto-updated timestamp of last modification"
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when the rule was created"
    }
  ]
}
