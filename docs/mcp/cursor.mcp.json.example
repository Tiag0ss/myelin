{
  "mcpServers": {
    "myelin": {
      "url": "https://YOUR-MYELIN-HOST/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MYELIN_API_TOKEN}"
      }
    },
    "myelin-local": {
      "url": "http://localhost:3000/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MYELIN_API_TOKEN_DEV}"
      }
    }
  }
}
